{
  "entities": {
    "DownloadBundle": {
      "title": "DownloadBundle",
      "description": "Pre-built downloadable LensLink ZIP bundle stored directly in Firebase Firestore for reliable zero-404 client downloads.",
      "type": "object",
      "properties": {
        "bundleId": {
          "type": "string",
          "description": "Canonical bundle identifier matching document ID.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^(browser-webcam|windows-vcam|pc-windows|android-studio)$"
        },
        "filename": {
          "type": "string",
          "description": "Download filename ending in .zip.",
          "minLength": 5,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9._-]+\\.zip$"
        },
        "contentType": {
          "type": "string",
          "description": "MIME type of archive.",
          "enum": ["application/zip"]
        },
        "sizeBytes": {
          "type": "integer",
          "description": "Raw binary ZIP byte size."
        },
        "zipBase64": {
          "type": "string",
          "description": "Base64-encoded ZIP archive payload.",
          "minLength": 8,
          "maxLength": 900000
        },
        "sha256": {
          "type": "string",
          "description": "Lowercase hex SHA-256 digest of the ZIP bytes.",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "version": {
          "type": "string",
          "description": "Release version string.",
          "minLength": 1,
          "maxLength": 32
        },
        "uploadedBy": {
          "type": "string",
          "description": "Firebase Auth UID of the uploader.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "bundleId",
        "filename",
        "contentType",
        "sizeBytes",
        "zipBase64",
        "sha256",
        "version",
        "uploadedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "WebRtcRoom": {
      "title": "WebRtcRoom",
      "description": "Ephemeral WebRTC signaling state for pairing a smartphone camera with a PC Receiver on the same network.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 6,
          "maxLength": 6,
          "pattern": "^[A-Z0-9]{6}$"
        },
        "sessionToken": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "pcName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "pcOnline": {
          "type": "boolean"
        },
        "phoneOnline": {
          "type": "boolean"
        },
        "phoneName": {
          "type": "string",
          "maxLength": 64
        },
        "phoneStreaming": {
          "type": "boolean"
        },
        "offerId": {
          "type": "string",
          "maxLength": 64
        },
        "offerSdp": {
          "type": "string",
          "maxLength": 25000
        },
        "answerForOfferId": {
          "type": "string",
          "maxLength": 64
        },
        "answerSdp": {
          "type": "string",
          "maxLength": 25000
        },
        "phoneIceCandidates": {
          "type": "array"
        },
        "pcIceCandidates": {
          "type": "array"
        },
        "restartNonce": {
          "type": "integer"
        },
        "focusNonce": {
          "type": "integer"
        },
        "focusX": {
          "type": "number"
        },
        "focusY": {
          "type": "number"
        },
        "captureNonce": {
          "type": "integer"
        },
        "settings": {
          "type": "object"
        },
        "capabilities": {
          "type": "object"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "code",
        "sessionToken",
        "pcName",
        "pcOnline",
        "phoneOnline",
        "phoneName",
        "phoneStreaming",
        "offerId",
        "offerSdp",
        "answerForOfferId",
        "answerSdp",
        "phoneIceCandidates",
        "pcIceCandidates",
        "restartNonce",
        "focusNonce",
        "focusX",
        "focusY",
        "captureNonce",
        "settings",
        "capabilities",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Verified administrator UID record.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "enum": ["admin"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "role", "createdAt"]
    }
  },
  "firestore": {
    "/download_bundles/{bundleId}": {
      "schema": { "$ref": "#/entities/DownloadBundle" },
      "description": "Downloadable LensLink ZIP installers and extensions stored in Firestore for zero-404 availability."
    },
    "/webrtc_rooms/{roomCode}": {
      "schema": { "$ref": "#/entities/WebRtcRoom" },
      "description": "Ephemeral WebRTC signaling documents enabling zero-config mobile-to-PC streaming across local Wi-Fi and deployed URLs."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Admin role lookup records."
    }
  }
}
