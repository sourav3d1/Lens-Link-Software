rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string
        && id.size() >= 1
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isCanonicalBundleId(bundleId) {
      return isValidId(bundleId)
        && bundleId.matches('^(browser-webcam|windows-vcam|pc-windows|android-studio)$');
    }

    function isRoomCode(code) {
      return code is string
        && code.size() == 6
        && code.matches('^[A-Z0-9]{6}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser()
        && (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          || request.auth.token.email == 'sourav3d1@gmail.com'
        );
    }

    function isValidDownloadBundle(data, bundleId) {
      return data.keys().hasAll([
          'bundleId',
          'filename',
          'contentType',
          'sizeBytes',
          'zipBase64',
          'sha256',
          'version',
          'uploadedBy',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'bundleId',
          'filename',
          'contentType',
          'sizeBytes',
          'zipBase64',
          'sha256',
          'version',
          'uploadedBy',
          'createdAt',
          'updatedAt'
        ])
        && data.bundleId is string
        && data.bundleId == bundleId
        && data.bundleId.size() <= 64
        && data.bundleId.matches('^(browser-webcam|windows-vcam|pc-windows|android-studio)$')
        && data.filename is string
        && data.filename.size() >= 5
        && data.filename.size() <= 128
        && data.filename.matches('^[a-zA-Z0-9._-]+\\.zip$')
        && data.contentType is string
        && data.contentType == 'application/zip'
        && data.sizeBytes is int
        && data.sizeBytes > 0
        && data.sizeBytes <= 750000
        && data.zipBase64 is string
        && data.zipBase64.size() >= 8
        && data.zipBase64.size() <= 900000
        && data.sha256 is string
        && data.sha256.size() == 64
        && data.sha256.matches('^[a-f0-9]{64}$')
        && data.version is string
        && data.version.size() >= 1
        && data.version.size() <= 32
        && data.uploadedBy is string
        && data.uploadedBy.size() >= 1
        && data.uploadedBy.size() <= 128
        && data.uploadedBy == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidIceList(listVal) {
      return listVal is list
        && listVal.size() <= 24
        && (listVal.size() == 0 || (listVal[0] is string && listVal[0].size() <= 600));
    }

    function isValidWebRtcRoom(data, roomCode) {
      return data.keys().hasAll([
          'code',
          'sessionToken',
          'pcName',
          'pcOnline',
          'phoneOnline',
          'phoneName',
          'phoneStreaming',
          'offerId',
          'offerSdp',
          'answerForOfferId',
          'answerSdp',
          'phoneIceCandidates',
          'pcIceCandidates',
          'restartNonce',
          'focusNonce',
          'focusX',
          'focusY',
          'captureNonce',
          'settings',
          'capabilities',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'code',
          'sessionToken',
          'pcName',
          'pcOnline',
          'phoneOnline',
          'phoneName',
          'phoneStreaming',
          'offerId',
          'offerSdp',
          'answerForOfferId',
          'answerSdp',
          'phoneIceCandidates',
          'pcIceCandidates',
          'restartNonce',
          'focusNonce',
          'focusX',
          'focusY',
          'captureNonce',
          'settings',
          'capabilities',
          'createdAt',
          'updatedAt'
        ])
        && data.code is string
        && data.code == roomCode
        && isRoomCode(data.code)
        && data.sessionToken is string
        && data.sessionToken.size() >= 8
        && data.sessionToken.size() <= 64
        && data.sessionToken.matches('^[a-zA-Z0-9_\\-]+$')
        && data.pcName is string
        && data.pcName.size() >= 1
        && data.pcName.size() <= 40
        && data.pcOnline is bool
        && data.phoneOnline is bool
        && data.phoneName is string
        && data.phoneName.size() <= 64
        && data.phoneStreaming is bool
        && data.offerId is string
        && data.offerId.size() <= 64
        && data.offerSdp is string
        && data.offerSdp.size() <= 25000
        && data.answerForOfferId is string
        && data.answerForOfferId.size() <= 64
        && data.answerSdp is string
        && data.answerSdp.size() <= 25000
        && isValidIceList(data.phoneIceCandidates)
        && isValidIceList(data.pcIceCandidates)
        && data.restartNonce is int
        && data.restartNonce >= 0
        && data.restartNonce <= 1000000
        && data.focusNonce is int
        && data.focusNonce >= 0
        && data.focusNonce <= 1000000
        && data.focusX is number
        && data.focusX >= 0
        && data.focusX <= 1
        && data.focusY is number
        && data.focusY >= 0
        && data.focusY <= 1
        && data.captureNonce is int
        && data.captureNonce >= 0
        && data.captureNonce <= 1000000
        && data.settings is map
        && data.settings.size() <= 25
        && data.capabilities is map
        && data.capabilities.size() <= 20
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /download_bundles/{bundleId} {
      // Public read-only single-document get by canonical bundle ID (zero PII)
      allow get: if isCanonicalBundleId(bundleId);
      allow list: if false;

      allow create: if isAdmin()
        && isCanonicalBundleId(bundleId)
        && isValidDownloadBundle(incoming(), bundleId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isCanonicalBundleId(bundleId)
        && isValidDownloadBundle(incoming(), bundleId)
        && incoming().bundleId == existing().bundleId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'filename',
          'contentType',
          'sizeBytes',
          'zipBase64',
          'sha256',
          'version',
          'uploadedBy',
          'updatedAt'
        ]);

      allow delete: if isAdmin() && isCanonicalBundleId(bundleId);
    }

    match /webrtc_rooms/{roomCode} {
      // Ephemeral WebRTC signaling rooms keyed by dynamic 6-char pairing code (zero PII)
      allow get: if isRoomCode(roomCode);
      allow list: if false;

      allow create: if isRoomCode(roomCode)
        && isValidWebRtcRoom(incoming(), roomCode)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isRoomCode(roomCode)
        && isValidWebRtcRoom(incoming(), roomCode)
        && incoming().code == existing().code
        && incoming().sessionToken == existing().sessionToken
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: PC session update / WebRTC answer / remote controls
          incoming().diff(existing()).affectedKeys().hasOnly([
            'pcName',
            'pcOnline',
            'answerForOfferId',
            'answerSdp',
            'pcIceCandidates',
            'restartNonce',
            'focusNonce',
            'focusX',
            'focusY',
            'captureNonce',
            'settings',
            'updatedAt'
          ])
          ||
          // Action: Smartphone join / WebRTC offer / capabilities / settings
          incoming().diff(existing()).affectedKeys().hasOnly([
            'phoneOnline',
            'phoneName',
            'phoneStreaming',
            'offerId',
            'offerSdp',
            'phoneIceCandidates',
            'capabilities',
            'settings',
            'updatedAt'
          ])
        );

      allow delete: if false;
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }
  }
}
