<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <!-- Compact Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bg_slate_950"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <ImageButton
            android:id="@+id/btnDisconnect"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Disconnect"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPairCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.12"
                android:text="K7M4P9"
                android:textColor="@color/text_slate_300"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="·"
                android:textColor="@color/text_slate_400" />

            <TextView
                android:id="@+id/tvConnectionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Connecting"
                android:textColor="@color/text_slate_300"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnOpenSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Camera settings"
            android:src="@drawable/ic_sliders" />
    </LinearLayout>

    <!-- Live Viewfinder Container -->
    <FrameLayout
        android:id="@+id/viewfinderContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000">

        <org.webrtc.SurfaceViewRenderer
            android:id="@+id/localSurfaceRenderer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/tvTechReadout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="12dp"
            android:background="#88000000"
            android:fontFamily="monospace"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="1080p · 1.0×"
            android:textColor="@color/text_slate_300"
            android:textSize="11sp" />

        <!-- Tap-to-Focus Reticle -->
        <View
            android:id="@+id/focusReticle"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_focus_reticle"
            android:visibility="gone" />

        <!-- Long-Press Vertical Brightness HUD -->
        <LinearLayout
            android:id="@+id/brightnessHud"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hud_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Brightness"
                android:src="@drawable/ic_sun" />

            <FrameLayout
                android:id="@+id/brightnessTrack"
                android:layout_width="28dp"
                android:layout_height="150dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp">

                <View
                    android:layout_width="6dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:background="#40FFFFFF" />

                <View
                    android:id="@+id/brightnessFill"
                    android:layout_width="6dp"
                    android:layout_height="75dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:background="@color/accent_amber" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvBrightnessValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="0%"
                android:textColor="@color/text_white"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Zoom Toast -->
        <TextView
            android:id="@+id/tvZoomToast"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_hud_card"
            android:fontFamily="monospace"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:text="1.0×"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Shutter Flash -->
        <View
            android:id="@+id/shutterFlash"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#BFFFFFFF"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Multi-Lens & Torch Bar -->
    <LinearLayout
        android:id="@+id/lensBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_slate_950"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/lensChipsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTorch"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/surface_slate_800"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Flash"
            android:textAllCaps="false"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            app:cornerRadius="10dp" />
    </LinearLayout>

    <!-- Clean 3-Button Thumb-Zone Dock -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_slate_950"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <ImageButton
            android:id="@+id/btnFlipCamera"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_hud_card"
            android:contentDescription="Switch front or rear camera"
            android:src="@drawable/ic_flip_camera" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleStream"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:backgroundTint="@color/primary_blue"
            android:text="Start Stream"
            android:textAllCaps="false"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCapturePhoto"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:backgroundTint="@color/text_white"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Photo"
            android:textAllCaps="false"
            android:textColor="@color/bg_slate_950"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="16dp" />
    </LinearLayout>
</LinearLayout>
